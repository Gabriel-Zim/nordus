# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=nordus
NORDUS_BIND_ADDRESS=127.0.0.1
NORDUS_HTTP_PORT=8080
# Leave empty to use http://localhost:${NORDUS_HTTP_PORT:-8080}.
NORDUS_PUBLIC_URL=
# Leave empty to inherit NORDUS_PUBLIC_URL.
NORDUS_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set NORDUS_PUBLIC_URL to https:// followed by the same hostname.
# Requires NORDUS_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
NORDUS_HTTPS_HOST=
NORDUS_BASE_IMAGE=ghcr.io/Gabriel-Zim/nordus:latest
NORDUS_LOCAL_IMAGE=nordus-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
NORDUS_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
NORDUS_DATA_EXTERNAL=false
